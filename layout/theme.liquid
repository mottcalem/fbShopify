  },

  'vd-kol': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Kol']
  }
};

    function createFilteredUrl(sourceUrl) {
      const url = new URL(
        sourceUrl,
        window.location.origin
      );

      const categoryCode = url.searchParams.get('fb');
      const category = categories[categoryCode];

      if (!category) return null;

      /* Tabanlıklar: yalnızca gerçek koleksiyonun ürünlerini göster. */
      if (category.collectionPath) {
        return new URL(category.collectionPath, window.location.origin).toString();
      }

      url.searchParams.delete('fb');
      url.searchParams.delete(category.filter);

      category.values.forEach(function (value) {
        url.searchParams.append(
          category.filter,
          value
        );
      });

      return url.toString();
    }

    /*
     * Link tıklanmadan önce gerçek filtre adresini oluştur.
     * Böylece ?fb=dc sayfası yüklenmez.
     */
    document.addEventListener('click', function (event) {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const link = event.target.closest(
        'a[href*="/collections/all?fb="]'
      );

      if (!link) return;

      const filteredUrl = createFilteredUrl(link.href);

      if (!filteredUrl) return;

      event.preventDefault();
      window.location.assign(filteredUrl);
    });

    /*
     * Kullanıcı kısa adresi doğrudan açarsa veya yeni sekmede
     * açarsa yedek yönlendirme çalışır.
     */
    const fallbackUrl = createFilteredUrl(
      window.location.href
    );

    if (fallbackUrl) {
      window.location.replace(fallbackUrl);
    }
  })();
</script>

<script>
  document.addEventListener('change', function (event) {
    const parent = event.target.closest(
      '.fb-category-filter__parent-checkbox'
    );

    if (!parent) return;

    const categoryMap = {
      socks: 'dc',
      body: 'vd'
    };

    const category = categoryMap[parent.dataset.fbParent];
    const allProductsUrl = {{ routes.all_products_collection_url | json }};

    if (!category) return;

    if (parent.checked) {
      window.location.href =
        allProductsUrl + '?fb=' + category;
    } else {
      window.location.href = allProductsUrl;
    }
  });
</script>

<script>
  document.addEventListener(
    'click',
    function (event) {
      const label = event.target.closest(
        '.fb-category-filter__item label'
      );

      if (!label) return;

      const input = label.querySelector(
        'input[type="checkbox"]'
      );

      /*
       * Yalnızca mevcut filtreler nedeniyle 0 olup
       * Shopify tarafından kapatılan seçenekleri yakala.
       */
      if (
        !input ||
        !input.disabled ||
        !input.name ||
        !input.value
      ) {
        return;
      }

      event.preventDefault();
      event.stopPropagation();

      const targetUrl = new URL(
        {{ routes.all_products_collection_url | json }},
        window.location.origin
      );

      targetUrl.searchParams.append(
        input.name,
        input.value
      );

      window.location.href = targetUrl.toString();
    },
    true
  );
</script>

