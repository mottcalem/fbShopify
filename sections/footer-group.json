ex;\n    min-height: 46px;\n    align-items: center;\n    padding: 9px 14px;\n    border: 1px dashed #ff8b3d;\n    border-radius: 8px;\n    color: #ff9a57;\n    font-size: 17px;\n    font-weight: 900;\n    letter-spacing: .08em;\n  }\n\n  .fb-footer__newsletter-code-row button {\n    padding: 9px 14px;\n    border: 1px solid rgba(255,255,255,.35);\n    border-radius: 8px;\n    background: transparent;\n    color: #fff;\n    font: inherit;\n    font-size: 12px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .fb-footer__newsletter-success > a {\n    display: flex;\n    width: 100%;\n    align-items: center;\n    justify-content: center;\n  }\n\n  @media screen and (max-width: 768px) {\n    .fb-footer__newsletter {\n      width: calc(100% - 56px);\n      grid-template-columns: 1fr;\n      gap: 20px;\n      padding: 32px 0;\n    }\n  }\n\n  @media screen and (max-width: 520px) {\n    .fb-footer__newsletter {\n      width: calc(100% - 44px);\n      padding: 28px 0;\n    }\n\n    .fb-footer__newsletter-fields,\n    .fb-footer__newsletter-code-row {\n      grid-template-columns: 1fr;\n    }\n\n    .fb-footer__newsletter-fields > button {\n      width: 100%;\n    }\n  }\n\n<\/style>\n\n<script>\n  (function () {\n    var root = document.getElementById('FbFooterNewsletter-{{ section.id }}');\n    if (!root || root.dataset.fbBound === '1') return;\n    root.dataset.fbBound = '1';\n\n    var success = root.querySelector('[data-fb-footer-success]');\n    var form = root.querySelector('form');\n    var formContent = root.querySelectorAll('[data-fb-footer-form-content]');\n    var button = root.querySelector('[data-fb-footer-copy]');\n    var code = root.querySelector('[data-fb-footer-code]');\n\n    var storageKey = 'fbFooterDiscountClaimed';\n    var cacheTtl = 30 * 60 * 1000;\n    var claimed = false;\n    var savedAt = 0;\n\n    try {\n      var stored = JSON.parse(localStorage.getItem(storageKey) || 'null');\n      savedAt = Number(stored && stored.savedAt);\n      claimed = Number.isFinite(savedAt) && Date.now() - savedAt < cacheTtl;\n      if (!claimed) localStorage.removeItem(storageKey);\n    } catch (error) {}\n\n    if (form) {\n      form.addEventListener('submit', function () {\n        try { localStorage.setItem(storageKey, JSON.stringify({ savedAt: Date.now() })); } catch (error) {}\n      });\n    }\n\n    if (success && (claimed || !success.hidden)) {\n      success.hidden = false;\n      formContent.forEach(function (element) { element.hidden = true; });\n    }\n\n    if (claimed) {\n      window.setTimeout(function () {\n        try { localStorage.removeItem(storageKey); } catch (error) {}\n        if (success) success.hidden = true;\n        formContent.forEach(function (element) { element.hidden = false; });\n      }, Math.max(0, cacheTtl - (Date.now() - savedAt)));\n    }\n\n    if (!button || !code) return;\n\n    button.addEventListener('click', function () {\n      var value = code.textContent.trim();\n\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        navigator.clipboard.writeText(value).then(function () {\n          button.textContent = 'Kopyalandı';\n        });\n        return;\n      }\n\n      var helper = document.createElement('input');\n      helper.value = code.textContent.trim();\n      document.body.appendChild(helper);\n      helper.select();\n      document.execCommand('copy');\n      helper.remove();\n      button.textContent = 'Kopyalandı';\n    });\n  })();\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}},"footer":{"type":"footer","disabled":true,"settings":{"color_scheme":"scheme-3","newsletter_enable":true,"newsletter_heading":"Yenilikleri kaçırmayın!","enable_follow_on_shop":true,"show_social":true,"enable_country_selector":true,"enable_language_selector":true,"payment_enable":true,"show_policy":true,"margin_top":0,"padding_top":36,"padding_bottom":36}}},"order":["custom_liquid_U4KiKk","footer"]}