{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} > .page-width,
    #shopify-section-{{ section.id }} .page-width {
      max-width: 1600px;
      padding-left: 32px;
      padding-right: 32px;
    }
  }

#shopify-section-{{ section.id }} .fb-cart__rewardbar {
  width: 100%;
  max-width: none;
  margin: 0 0 2rem;
  box-sizing: border-box;
  overflow: visible;
}

#shopify-section-{{ section.id }} .cart__items,
#shopify-section-{{ section.id }} .cart-items {
  width: 100%;
  max-width: none;
}

#shopify-section-{{ section.id }} .fb-cart__rewardbar .fb-cart__shipbar-text {
  line-height: 1.5;
}

#shopify-section-{{ section.id }} .fb-cart__rewardbar .fb-cart__shipbar-track {
  position: relative;
  overflow: visible;
}

#shopify-section-{{ section.id }} .fb-cart__reward-dot {
  position: absolute;
  top: 50%;
  width: 12px;
  height: 12px;
  border: 2px solid #ff6500;
  border-radius: 50%;
  background: #fff;
  transform: translate(-50%, -50%);
  z-index: 2;
}

#shopify-section-{{ section.id }} .fb-cart__reward-dot.is-active {
  background: #ff6500;
  box-shadow: 0 0 0 3px rgba(255, 101, 0, 0.14);
}

#shopify-section-{{ section.id }} .fb-cart__reward-dot--10 {
  left: 55.55%;
}

#shopify-section-{{ section.id }} .fb-cart__reward-dot--shipping {
  left: 33.33%;
}

#shopify-section-{{ section.id }} .fb-cart__reward-dot--15 {
  left: 77.77%;
}

#shopify-section-{{ section.id }} .fb-cart__reward-dot--20 {
  left: 100%;
}

#shopify-section-{{ section.id }} .fb-cart__reward-levels {
  position: relative;
  height: 4.8rem;
  margin-top: 1.2rem;
  color: #7d746b;
  font-size: 1.1rem;
  line-height: 1.25;
}

#shopify-section-{{ section.id }} .fb-cart__reward-level {
  position: absolute;
  top: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 6.2rem;
  text-align: center;
  transform: translateX(-50%);
}

#shopify-section-{{ section.id }} .fb-cart__reward-level strong {
  color: #173451;
  font-size: 1.5rem;
  font-weight: 700;
}

#shopify-section-{{ section.id }} .fb-cart__reward-level small {
  margin-top: .2rem;
  color: #7d746b;
  font-size: 1.25rem;
  font-weight: 600;
  white-space: nowrap;
}

#shopify-section-{{ section.id }} .fb-cart__reward-level--shipping { left: 33.33%; }
#shopify-section-{{ section.id }} .fb-cart__reward-level--10 { left: 55.55%; }
#shopify-section-{{ section.id }} .fb-cart__reward-level--15 { left: 77.77%; }
#shopify-section-{{ section.id }} .fb-cart__reward-level--20 { left: 100%; transform: translateX(-100%); align-items: flex-end; text-align: right; }

#shopify-section-{{ section.id }} .fb-cart__reward-level.is-active strong,
#shopify-section-{{ section.id }} .fb-cart__reward-level.is-active small {
  color: #d95600;
}

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} .fb-cart__reward-levels {
    height: 2.4rem;
    margin-top: .9rem;
  }

  #shopify-section-{{ section.id }} .fb-cart__reward-level {
    min-width: auto;
  }

  #shopify-section-{{ section.id }} .fb-cart__reward-level strong {
    font-size: .9rem;
  }

  #shopify-section-{{ section.id }} .fb-cart__reward-level small {
    display: none;
  }
}

#shopify-section-{{ section.id }} .fb-cart__rewardbar,
#shopify-section-{{ section.id }} .fb-cart__rewardbar .fb-cart__shipbar-text,
#shopify-section-{{ section.id }} .fb-cart__rewardbar .fb-cart__reward-levels {
  font-weight: 700;
}

#shopify-section-{{ section.id }} .fb-cart__reward-levels {
  color: #554d46;
}

  
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{% comment %}
  FootBalance: Dawn'ın sepet tablosu markup'ı BİLEREK korundu. Adet kuralları,
  hacim fiyatlandırma, satır silme ve AJAX tazeleme (`cart.js` → `.js-contents`)
  hep buna bağlı; baştan yazılsa davranış kırılırdı.

  Referans tasarımdaki kart görünümü CSS ile kuruluyor:
  `footbalance-custom.css` → "SEPET" bölümü. Tablo orada karta çevriliyor.

  Liquid tarafına eklenen tek şey: ücretsiz kargo çubuğu ve alt aksiyon satırı.
  İkisi de `.js-contents` İÇİNDE — sepet değişince kendiliğinden tazeleniyorlar.
{% endcomment %}

<cart-items
  class="fb-cart gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            {%- comment -%}
              Ücretsiz kargo çubuğu. Eşik panelden giriliyor (Settings → Shipping
              ile aynı rakam olmalı, Liquid kargo eşiğini okuyamıyor).
              0 girilirse çubuk hiç basılmaz.
            {%- endcomment -%}
            
            {%- comment -%}
  FootBalance — ciro bazlı avantaj göstergesi

  0–2.999 TL   → İndirim yok
  3.000–4.999  → Ücretsiz kargo
  5.000–6.999  → %10 indirim
  7.000–8.999  → %15 indirim
  9.000 TL+    → %20 indirim

  Hesaplama indirim uygulanmadan önceki ürün ara toplamına göre yapılır.
{%- endcomment -%}

{%- assign fb_cart_subtotal = cart.original_total_price -%}
{%- assign fb_shipping_level = 300000 -%}
{%- assign fb_level_10 = 500000 -%}
{%- assign fb_level_15 = 700000 -%}
{%- assign fb_level_20 = 900000 -%}

{%- assign fb_current_discount = 0 -%}
{%- assign fb_shipping_unlocked = false -%}
{%- assign fb_next_discount = 10 -%}
{%- assign fb_next_threshold = fb_shipping_level -%}

{%- if fb_cart_subtotal >= fb_shipping_level -%}
  {%- assign fb_shipping_unlocked = true -%}
{%- endif -%}

{%- if fb_cart_subtotal >= fb_level_20 -%}
  {%- assign fb_current_discount = 20 -%}
  {%- assign fb_next_discount = 20 -%}
  {%- assign fb_next_threshold = fb_level_20 -%}
{%- elsif fb_cart_subtotal >= fb_level_15 -%}
  {%- assign fb_current_discount = 15 -%}
  {%- assign fb_next_discount = 20 -%}
  {%- assign fb_next_threshold = fb_level_20 -%}
{%- elsif fb_cart_subtotal >= fb_level_10 -%}
  {%- assign fb_current_discount = 10 -%}
  {%- assign fb_next_discount = 15 -%}
  {%- assign fb_next_threshold = fb_level_15 -%}
{%- elsif fb_cart_subtotal >= fb_shipping_level -%}
  {%- assign fb_next_discount = 10 -%}
  {%- assign fb_next_threshold = fb_level_10 -%}
{%- endif -%}

{%- assign fb_remaining = fb_next_threshold | minus: fb_cart_subtotal -%}
{%- if fb_remaining < 0 -%}
  {%- assign fb_remaining = 0 -%}
{%- endif -%}

{%- assign fb_progress = fb_cart_subtotal
  | times: 100
  | divided_by: fb_level_20
-%}

{%- if fb_progress > 100 -%}
  {%- assign fb_progress = 100 -%}
{%- endif -%}

<div class="fb-cart__shipbar fb-cart__rewardbar">
  <p class="fb-cart__shipbar-text">
    {%- if fb_current_discount == 0 and fb_shipping_unlocked == false -%}
  {% if localization.language.iso_code == 'en' %}Add{% else %}Ücretsiz kargo için{% endif %}
  <strong>
    {{ fb_remaining | money_without_trailing_zeros }}
    {{ cart.currency.iso_code | default: shop.currency }}
  </strong>
  {% if localization.language.iso_code == 'en' %}more for free shipping.{% else %}daha ekleyin.{% endif %}
    {%- elsif fb_current_discount == 0 -%}
      <strong>{% if localization.language.iso_code == 'en' %}You've unlocked free shipping.{% else %}Ücretsiz kargo kazandınız.{% endif %}</strong>
      {% if localization.language.iso_code == 'en' %}Add{% else %}%10 indirim için{% endif %}
      <strong>
        {{ fb_remaining | money_without_trailing_zeros }}
        {{ cart.currency.iso_code | default: shop.currency }}
      </strong>
      {% if localization.language.iso_code == 'en' %}more for 10% off.{% else %}daha ekleyin.{% endif %}
    {%- elsif fb_current_discount < 20 -%}
      <strong>
        {% if localization.language.iso_code == 'en' %}You've unlocked free shipping and {{ fb_current_discount }}% off.{% else %}Ücretsiz kargo ve %{{ fb_current_discount }} indirimi kazandınız.{% endif %}
      </strong>
      {% if localization.language.iso_code == 'en' %}Add{% else %}%{{ fb_next_discount }} indirim için{% endif %}
      <strong>
  {{ fb_remaining | money_without_trailing_zeros }}
  {{ cart.currency.iso_code | default: shop.currency }}
</strong>
      {% if localization.language.iso_code == 'en' %}more for {{ fb_next_discount }}% off.{% else %}daha ekleyin.{% endif %}
    {%- else -%}
      <strong>
        {% if localization.language.iso_code == 'en' %}Congratulations! You've unlocked free shipping and the maximum 20% discount.{% else %}Tebrikler! Ücretsiz kargo ve en yüksek seviye olan %20 indirimi kazandınız.{% endif %}
      </strong>
    {%- endif -%}
  </p>

  <div
    class="fb-cart__shipbar-track"
    role="progressbar"
    aria-label="{% if localization.language.iso_code == 'en' %}Cart rewards progress{% else %}Sepet avantaj seviyesi{% endif %}"
    aria-valuemin="0"
    aria-valuemax="9000"
    aria-valuenow="{{ fb_cart_subtotal | divided_by: 100 }}"
  >
    <span
      class="fb-cart__shipbar-fill"
      style="width: {{ fb_progress }}%"
    ></span>

    <span
      class="fb-cart__reward-dot fb-cart__reward-dot--shipping{% if fb_shipping_unlocked %} is-active{% endif %}"
      aria-hidden="true"
    ></span>

    <span
      class="fb-cart__reward-dot fb-cart__reward-dot--10{% if fb_cart_subtotal >= fb_level_10 %} is-active{% endif %}"
      aria-hidden="true"
    ></span>

    <span
      class="fb-cart__reward-dot fb-cart__reward-dot--15{% if fb_cart_subtotal >= fb_level_15 %} is-active{% endif %}"
      aria-hidden="true"
    ></span>

    <span
      class="fb-cart__reward-dot fb-cart__reward-dot--20{% if fb_cart_subtotal >= fb_level_20 %} is-active{% endif %}"
      aria-hidden="true"
    ></span>
  </div>

<div class="fb-cart__reward-levels" aria-hidden="true">
  <span class="fb-cart__reward-level fb-cart__reward-level--shipping{% if fb_shipping_unlocked %} is-active{% endif %}">
    <strong>3.000 TL</strong>
    <small>{% if localization.language.iso_code == 'en' %}Free shipping threshold{% else %}Ücretsiz kargo eşiği{% endif %}</small>
  </span>
  <span class="fb-cart__reward-level fb-cart__reward-level--10{% if fb_cart_subtotal >= fb_level_10 %} is-active{% endif %}">
    <strong>5.000 TL</strong>
    <small>{% if localization.language.iso_code == 'en' %}10% off{% else %}%10 indirim{% endif %}</small>
  </span>
  <span class="fb-cart__reward-level fb-cart__reward-level--15{% if fb_cart_subtotal >= fb_level_15 %} is-active{% endif %}">
    <strong>7.000 TL</strong>
    <small>{% if localization.language.iso_code == 'en' %}15% off{% else %}%15 indirim{% endif %}</small>
  </span>
  <span class="fb-cart__reward-level fb-cart__reward-level--20{% if fb_cart_subtotal >= fb_level_20 %} is-active{% endif %}">
    <strong>9.000 TL</strong>
    <small>{% if localization.language.iso_code == 'en' %}20% off{% else %}%20 indirim{% endif %}</small>
  </span>
</div>
</div>

            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for item in cart.items -%}
                  <tr
                    class="cart-item {% if item.parent_relationship.parent != null %}cart-item__nested-line{% endif %}"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                  >
                    <td class="cart-item__media">
                      {%- liquid
                        assign fb_cart_image = item.image
                        assign fb_listing_image = item.product.metafields.custom.listing_image.value
                        if fb_listing_image.media_type == 'image' and fb_listing_image.preview_image != blank
                          assign fb_cart_image = fb_listing_image.preview_image
                        endif
                      -%}
                      {% if fb_cart_image %}
                        {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                        <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                        <div class="cart-item__image-container gradient {% if item.parent_relationship.parent == null %}global-media-settings{% endif %}">
                          <img
                            src="{{ fb_cart_image | image_url: width: 300 }}"
                            class="cart-item__image {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                            alt="{{ fb_cart_image.alt | default: item.product.title | escape }}"
                            loading="lazy"
                            width="150"
                            height="{{ 150 | divided_by: fb_cart_image.aspect_ratio | ceil }}"
                          >
                        </div>
                      {% endif %}
                    </td>

                    <td class="cart-item__details">
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <div class="cart-item__title">
                        <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>
                        {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-cart-' | append: item.key | replace: ':', '-' -%}
                        {%- render 'cart-disclosure-indicator',
                          product: item.product,
                          modal_id: cart_disclosure_modal_id
                        -%}
                      </div>

                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s class="cart-item__old-price product-option">
                            {{- item.original_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong class="cart-item__final-price product-option">
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {%- else -%}
                        <div class="product-option">
                          {{ item.original_price | money }}
                        </div>
                      {%- endif -%}

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        <dl>
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option">
                                <dt>{{ option.name }}:</dt>
                                <dd>{{ option.value }}</dd>
                              </div>
                            {%- endfor -%}
                          {%- endif -%}

                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="product-option">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">
                                      {{ property.last | split: '/' | last }}
                                    </a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>

                        <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>

                    <td class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif

                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                aria-expanded="false"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                              >
                                {{- 'icon-info.svg' | inline_asset_content -}}
                              </button>
                            {%- endif -%}
                            <quantity-input class="quantity cart-quantity">
                              {% assign can_update_quantity = item.instructions.can_update_quantity | default: true %}
                              <button
                                class="quantity__button"
                                name="minus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-minus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                data-quantity-line-key="{{ item.key }}"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                              <button
                                class="quantity__button"
                                name="plus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-plus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                            {% assign can_remove = item.instructions.can_remove | default: true %}
                            {% if can_remove == false %}
                              class="hidden"
                            {% endif %}
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-remove.svg' | inline_asset_content -}}
                              </span>
                            </a>
                          </cart-remove-button>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                            aria-expanded="false"
                          >
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- elsif has_qty_rules -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        {%- endif -%}
                        {%- if has_vol_pricing or has_qty_rules -%}
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.multiples_of'
                                    | t: quantity: item.variant.quantity_rule.increment
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.min_of'
                                    | t: quantity: item.variant.quantity_rule.min
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.max_of'
                                    | t: quantity: item.variant.quantity_rule.max
                                  -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary large-up-hide"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    {%- assign price = item.variant.price | money_with_currency -%}
                                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      {%- assign price = price_break.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </td>

                    <td class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>

            <div class="fb-cart__actions">
              <a href="{{ routes.cart_clear_url }}" class="fb-cart__clear">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="3 6 5 6 21 6" />
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                  <path d="M10 11v6M14 11v6" />
                </svg>
                {% if localization.language.iso_code == 'en' %}Clear cart{% else %}Sepeti Temizle{% endif %}
              </a>
              <a href="{{ routes.all_products_collection_url }}" class="fb-cart__continue">
                {% if localization.language.iso_code == 'en' %}Continue shopping{% else %}Alışverişe Devam Et{% endif %}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Ücretsiz kargo eşiği (TL)",
      "info": "Settings → Shipping'deki rakamla aynı olmalı — Liquid kargo ayarını okuyamıyor. 0 girilirse çubuk gösterilmez.",
      "default": 3000
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
