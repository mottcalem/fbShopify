{%- comment -%}
  FootBalance koleksiyon SEO içeriği
  Kaynak: Shopify koleksiyon açıklaması veya aktif birleşik filtreye
  eşlenen başka bir koleksiyonun açıklaması.
  Bölümü koleksiyon şablonunda ürün listesinin üstüne ekleyin.
{%- endcomment -%}

{%- liquid
  assign seo_content = collection.description
  assign active_unified_value = blank
  assign active_unified_count = 0

  for collection_filter in collection.filters
    if collection_filter.param_name == 'filter.p.m.custom.birlesik_kategori_filtresi'
      assign active_unified_count = collection_filter.active_values.size
      if active_unified_count == 1
        assign first_active_value = collection_filter.active_values | first
        assign active_unified_value = first_active_value.label | strip
      endif
    endif
  endfor

  if collection.handle == 'all' and active_unified_count > 0
    assign seo_content = blank

    if active_unified_count == 1
      for block in section.blocks
        assign configured_filter_value = block.settings.filter_value | strip
        if configured_filter_value == active_unified_value and block.settings.source_collection != blank
          assign seo_content = block.settings.source_collection.description
          break
        endif
      endfor
    endif
  endif
-%}

{%- if seo_content != blank -%}
  <section
    class="fb-collection-seo page-width"
    id="FBCollectionSeo-{{ section.id }}"
    style="--fb-seo-collapsed-height: {{ section.settings.collapsed_height }}px;"
  >
    <div class="fb-collection-seo__content rte" id="FBCollectionSeoContent-{{ section.id }}">
      {{ seo_content }}
    </div>

    <button
      class="fb-collection-seo__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="FBCollectionSeoContent-{{ section.id }}"
      hidden
    >
      <span class="fb-collection-seo__toggle-open">{{ section.settings.open_label | escape }} ↓</span>
      <span class="fb-collection-seo__toggle-close">{{ section.settings.close_label | escape }} ↑</span>
    </button>
  </section>

  <style>
    #FBCollectionSeo-{{ section.id }} {
      color: #1a1a1a;
      line-height: 1.65;
      margin-top: 1.2rem;
      margin-bottom: 2.4rem;
    }

    #FBCollectionSeo-{{ section.id }} .fb-collection-seo__content {
      box-sizing: border-box;
      width: 100%;
      max-height: var(--fb-seo-collapsed-height);
      padding: 0 2.4rem 2.4rem;
      overflow: hidden;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      transition: max-height 0.45s ease;
    }

    #FBCollectionSeo-{{ section.id }} .fb-cat {
      color: #526170;
      font-size: 1.55rem;
      line-height: 1.75;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    /* HTML içindeki eski aç/kapat etiketlerini gizler.
       Açma işlemini yalnızca bölümün kendi butonu yönetir. */
    #FBCollectionSeo-{{ section.id }} .fb-cat .fb-btn,
    #FBCollectionSeo-{{ section.id }} .fb-cat label[for="fb-komp-toggle"] {
      display: none !important;
    }

    #FBCollectionSeo-{{ section.id }} .fb-extra {
      display: block;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    #FBCollectionSeo-{{ section.id }} .fb-extra::before,
    #FBCollectionSeo-{{ section.id }} .fb-extra::after,
    #FBCollectionSeo-{{ section.id }} .fb-cat::before,
    #FBCollectionSeo-{{ section.id }} .fb-cat::after {
      display: none !important;
      content: none !important;
      box-shadow: none !important;
    }

    #FBCollectionSeo-{{ section.id }}.is-expanded .fb-collection-seo__content {
      max-height: none;
      overflow: visible;
    }

    #FBCollectionSeo-{{ section.id }} .fb-intro,
    #FBCollectionSeo-{{ section.id }} .fb-model,
    #FBCollectionSeo-{{ section.id }} .fb-uyari,
    #FBCollectionSeo-{{ section.id }} .fb-related {
      border: 1px solid rgba(11, 47, 79, 0.10);
      border-radius: 1.6rem;
      background: #ffffff;
      box-shadow: 0 0.8rem 2.8rem rgba(11, 47, 79, 0.06);
      padding: 2rem 2.2rem;
      margin: 1.2rem 0 1.8rem;
    }

    #FBCollectionSeo-{{ section.id }} .fb-intro {
      border-color: rgba(255, 107, 0, 0.24);
      background: #fff8f2;
      color: #263d51;
      font-size: 1.65rem;
    }

    #FBCollectionSeo-{{ section.id }} .fb-intro p:last-child,
    #FBCollectionSeo-{{ section.id }} .fb-model p:last-child,
    #FBCollectionSeo-{{ section.id }} .fb-related ul:last-child {
      margin-bottom: 0;
    }

    #FBCollectionSeo-{{ section.id }} h2 {
      border-left: 0.35rem solid #ff6b00;
      color: #071b2c;
      font-size: clamp(2rem, 2.3vw, 2.6rem);
      font-weight: 800;
      margin: 3.2rem 0 1.2rem;
      padding-left: 1.4rem;
    }

    #FBCollectionSeo-{{ section.id }} h3 {
      color: #0b2f4f;
      font-size: 1.9rem;
      font-weight: 700;
      margin: 2rem 0 0.8rem;
    }

    #FBCollectionSeo-{{ section.id }} p {
      margin: 0 0 1.4rem;
    }

    #FBCollectionSeo-{{ section.id }} ul {
      margin: 0 0 1.8rem;
      padding-left: 2.2rem;
    }

    #FBCollectionSeo-{{ section.id }} li {
      margin-bottom: 0.7rem;
    }

    #FBCollectionSeo-{{ section.id }} a {
      color: #0b2f4f;
      text-decoration-color: rgba(255, 107, 0, 0.75);
      text-underline-offset: 0.3rem;
    }

    #FBCollectionSeo-{{ section.id }} a:hover {
      color: #ff6b00;
    }

    #FBCollectionSeo-{{ section.id }} .fb-uyari {
      border-color: rgba(255, 107, 0, 0.30);
      border-left: 0.45rem solid #ff6b00;
      background: #fff7ef;
      color: #263d51;
    }

    #FBCollectionSeo-{{ section.id }} .fb-related {
      background: #f7fafc;
    }

    #FBCollectionSeo-{{ section.id }} .fb-related h3 {
      margin-top: 0;
    }

    #FBCollectionSeo-{{ section.id }} details {
      border: 1px solid rgba(10, 35, 55, 0.10);
      border-radius: 1.4rem;
      margin-bottom: 1rem;
      background: #fff;
      overflow: hidden;
    }

    #FBCollectionSeo-{{ section.id }} details[open] {
      box-shadow: 0 0.4rem 2rem rgba(10, 35, 55, 0.07);
    }

    #FBCollectionSeo-{{ section.id }} summary {
      align-items: center;
      cursor: pointer;
      display: flex;
      font-weight: 700;
      justify-content: space-between;
      list-style: none;
      padding: 1.5rem 2rem;
      color: #0b2f4f;
    }

    #FBCollectionSeo-{{ section.id }} summary::-webkit-details-marker {
      display: none;
    }

    #FBCollectionSeo-{{ section.id }} summary::after {
      content: '+';
      font-size: 2.2rem;
      font-weight: 400;
    }

    #FBCollectionSeo-{{ section.id }} details[open] summary::after {
      content: '−';
    }

    #FBCollectionSeo-{{ section.id }} details > :not(summary) {
      margin-left: 2rem;
      margin-right: 2rem;
    }

    #FBCollectionSeo-{{ section.id }} .fb-collection-seo__toggle {
      appearance: none;
      background: #fff;
      border: 1px solid rgba(7, 27, 44, 0.22);
      border-radius: 999px;
      color: #071b2c;
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      margin-top: 1.8rem;
      padding: 1.1rem 2.4rem;
    }

    #FBCollectionSeo-{{ section.id }} .fb-collection-seo__toggle:hover {
      background: #0b2f4f;
      border-color: #0b2f4f;
      color: #fff;
    }

    #FBCollectionSeo-{{ section.id }} .fb-collection-seo__toggle-close {
      display: none;
    }

    #FBCollectionSeo-{{ section.id }}.is-expanded .fb-collection-seo__toggle-open {
      display: none;
    }

    #FBCollectionSeo-{{ section.id }}.is-expanded .fb-collection-seo__toggle-close {
      display: inline;
    }

    @media screen and (max-width: 749px) {
      #FBCollectionSeo-{{ section.id }} {
        margin-bottom: 2rem;
      }

      #FBCollectionSeo-{{ section.id }} .fb-cat {
        font-size: 1.45rem;
        line-height: 1.7;
      }

      #FBCollectionSeo-{{ section.id }} .fb-collection-seo__content {
        padding: 0 1.4rem 1.8rem;
      }

      #FBCollectionSeo-{{ section.id }} .fb-intro,
      #FBCollectionSeo-{{ section.id }} .fb-model,
      #FBCollectionSeo-{{ section.id }} .fb-uyari,
      #FBCollectionSeo-{{ section.id }} .fb-related {
        border-radius: 1.2rem;
        padding: 1.6rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #FBCollectionSeo-{{ section.id }} .fb-collection-seo__content {
        transition: none;
      }
    }
  </style>

  <script>
    (() => {
      const section = document.getElementById('FBCollectionSeo-{{ section.id }}');
      if (!section || section.dataset.initialized === 'true') return;

      const content = section.querySelector('.fb-collection-seo__content');
      const toggle = section.querySelector('.fb-collection-seo__toggle');
      if (!content || !toggle) return;

      section.dataset.initialized = 'true';

      const updateToggle = () => {
        if (section.classList.contains('is-expanded')) return;
        const collapsedHeight = parseFloat(getComputedStyle(section).getPropertyValue('--fb-seo-collapsed-height'));
        toggle.hidden = content.scrollHeight <= collapsedHeight + 2;
      };

      toggle.addEventListener('click', () => {
        const expanded = section.classList.toggle('is-expanded');
        toggle.setAttribute('aria-expanded', String(expanded));

        if (!expanded) {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });

      updateToggle();
      window.addEventListener('resize', updateToggle, { passive: true });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Koleksiyon SEO içeriği",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "collapsed_height",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Kapalı görünüm yüksekliği",
      "default": 150
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "Açma bağlantısı",
      "default": "Devamını oku"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Kapatma bağlantısı",
      "default": "Daha az göster"
    }
  ],
  "blocks": [
    {
      "type": "filter_mapping",
      "name": "Filtre SEO eşleştirmesi",
      "settings": [
        {
          "type": "text",
          "id": "filter_value",
          "label": "Birleşik filtre değeri",
          "info": "Filtrede göründüğü şekliyle yazın. Örnek: Koşu ve Toparlanma"
        },
        {
          "type": "collection",
          "id": "source_collection",
          "label": "İçeriği alınacak koleksiyon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Koleksiyon SEO içeriği"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
