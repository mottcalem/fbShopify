{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .fb-blog {
    max-width: 1400px;
    margin: 0 auto;
  }

  .fb-blog__title {
    margin: 0 0 48px;
    text-align: center;
    font-size: 42px;
    line-height: 1.2;
    font-weight: 500;
    color: #222;
  }

  .fb-blog__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 64px 24px;
  }

  .fb-blog-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
  }

  .fb-blog-card__image-link {
    display: block;
    width: 100%;
    overflow: hidden;
    text-decoration: none;
  }

  .fb-blog-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: none;
    overflow: hidden;
    background: #f5f5f5;
  }

  .fb-blog-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .fb-blog-card:hover .fb-blog-card__image {
    transform: scale(1.02);
  }

  .fb-blog-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 28px;
  }

  .fb-blog-card__title {
    margin: 0;
    font-size: 22px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .fb-blog-card__title a {
    color: #222;
    text-decoration: none;
  }

  .fb-blog-card__title a:hover {
    opacity: 0.75;
  }

  .fb-blog-card__excerpt {
    margin: 28px 0 0;
    color: #555;
    font-size: 16px;
    line-height: 1.7;

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .fb-blog-card__read-more {
    align-self: flex-end;
    margin-top: auto;
    padding-top: 30px;
    color: #333;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .fb-blog-card__read-more span {
    display: inline-block;
    padding-bottom: 7px;
    border-bottom: 1px solid #333;
  }

  .fb-blog-card__read-more:hover {
    opacity: 0.7;
  }

  .fb-blog__pagination {
    margin-top: 64px;
  }

  @media screen and (max-width: 989px) {
    .fb-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 50px 22px;
    }

    .fb-blog__title {
      font-size: 36px;
      margin-bottom: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .fb-blog__grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .fb-blog__title {
      font-size: 30px;
      margin-bottom: 32px;
    }

    .fb-blog-card__content {
      padding-top: 20px;
    }

    .fb-blog-card__title {
      font-size: 20px;
    }

    .fb-blog-card__excerpt {
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.65;
    }

    .fb-blog-card__read-more {
      margin-top: 22px;
      padding-top: 0;
      font-size: 14px;
    }
  }
{%- endstyle -%}

{%- paginate blog.articles by 9 -%}

  <div class="main-blog page-width section-{{ section.id }}-padding">

    <div class="fb-blog">

      <h1 class="fb-blog__title">
        FootBalance Blog
      </h1>

      <div class="fb-blog__grid">

        {%- for article in blog.articles -%}

          <article class="fb-blog-card">

            {%- if article.image -%}

              <a
                href="{{ article.url }}"
                class="fb-blog-card__image-link"
                aria-label="{{ article.title | escape }}"
              >
                <div class="fb-blog-card__image-wrapper">

                  {{
                    article.image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'fb-blog-card__image',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      alt: article.image.alt
                  }}

                </div>
              </a>

            {%- endif -%}

            <div class="fb-blog-card__content">

              <h2 class="fb-blog-card__title">
                <a href="{{ article.url }}">
                  {{ article.title | escape }}
                </a>
              </h2>

              {%- if article.excerpt != blank -%}

                <div class="fb-blog-card__excerpt">
                  {{ article.excerpt | strip_html }}
                </div>

              {%- else -%}

                <div class="fb-blog-card__excerpt">
                  {{ article.content | strip_html | truncatewords: 28 }}
                </div>

              {%- endif -%}

              <a
                href="{{ article.url }}"
                class="fb-blog-card__read-more"
                aria-label="{{ article.title | escape }} {% if localization.language.iso_code == 'en' %}read more{% else %}devamını oku{% endif %}"
              >
                <span>{% if localization.language.iso_code == 'en' %}Read more{% else %}Devamını Oku{% endif %}</span>
              </a>

            </div>

          </article>

        {%- endfor -%}

      </div>

      {%- if paginate.pages > 1 -%}
        <div class="fb-blog__pagination">
          {%- render 'pagination', paginate: paginate -%}
        </div>
      {%- endif -%}

    </div>

  </div>

{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Üst boşluk",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Alt boşluk",
      "default": 64
    }
  ]
}
{% endschema %}
