{% render 'fb-insole-facet', results: results, section_id: section.id, location: 'mobile' %}
{%- if mobile_unified_category_filter == nil -%}
<h4 class="fb-mobile-category-inline__group-title"><a href="{{ routes.all_products_collection_url }}?fb=dc">{% if localization.language.iso_code == 'en' %}Support Socks{% else %}Destek Çorapları{% endif %}</a></h4>
