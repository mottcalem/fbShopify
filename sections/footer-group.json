\n    padding: 0;\n    list-style: none;\n  }\n\n  .fb-footer__column li {\n    margin: 0 0 5px;\n  }\n\n  .fb-footer__column a,\n  .fb-footer__legal a {\n    color: #d4deea;\n    text-decoration: none;\n\n    transition:\n      opacity .2s ease,\n      color .2s ease;\n  }\n\n  .fb-footer__column a {\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .fb-footer__column a:hover,\n  .fb-footer__legal a:hover {\n    opacity: .72;\n  }\n\n\n  \/* =========================\n     FOOTER ALT\n  ========================== *\/\n\n  .fb-footer__bottom {\n    border-top: 1px solid rgba(255,255,255,.12);\n  }\n\n  .fb-footer__bottom-inner {\n    max-width: 1600px;\n    min-height: 95px;\n\n    margin: 0 auto;\n    padding: 0 48px;\n\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n\n    gap: 30px;\n  }\n\n  .fb-footer__copyright {\n    color: #bac7d6;\n    font-size: 14px;\n  }\n\n  .fb-footer__legal {\n    display: flex;\n    align-items: center;\n    gap: 28px;\n  }\n\n  .fb-footer__legal a {\n    color: #bac7d6;\n    font-size: 14px;\n  }\n\n\n  \/* =========================\n     TABLET\n  ========================== *\/\n\n  @media screen and (max-width: 1100px) {\n\n    .fb-footer__inner {\n      grid-template-columns: 1.3fr 1fr 1fr;\n      gap: 50px;\n    }\n\n    .fb-footer__brand {\n      grid-row: span 2;\n    }\n\n  }\n\n\n  \/* =========================\n     MOBILE\n  ========================== *\/\n\n  @media screen and (max-width: 768px) {\n\n    .fb-footer__inner {\n      grid-template-columns: 1fr 1fr;\n      gap: 45px 30px;\n\n      padding:\n        55px 28px\n        55px;\n    }\n\n    .fb-footer__brand {\n      grid-column: 1 \/ -1;\n      grid-row: auto;\n      max-width: 520px;\n    }\n\n    .fb-footer__bottom-inner {\n      min-height: auto;\n\n      padding:\n        26px 28px;\n\n      flex-direction: column;\n      align-items: flex-start;\n    }\n\n    .fb-footer__legal {\n      flex-wrap: wrap;\n      gap: 14px 22px;\n    }\n\n  }\n\n\n  @media screen and (max-width: 520px) {\n\n    .fb-footer__inner {\n      grid-template-columns: 1fr;\n      gap: 34px;\n\n      padding:\n        45px 22px\n        48px;\n    }\n\n    .fb-footer__logo img {\n      width: 220px;\n    }\n\n    .fb-footer__brand p {\n      font-size: 16px;\n    }\n\n    .fb-footer__column h3 {\n      margin-bottom: 16px;\n      font-size: 18px;\n    }\n\n    .fb-footer__column li {\n      margin-bottom: 14px;\n    }\n\n    .fb-footer__column a {\n      font-size: 16px;\n    }\n\n    .fb-footer__bottom-inner {\n      padding:\n        24px 22px;\n    }\n\n    .fb-footer__copyright,\n    .fb-footer__legal a {\n      font-size: 14px;\n    }\n\n    .fb-footer__badges {\n      gap: 14px;\n      margin-top: 24px;\n    }\n\n    .fb-footer__badge--etbis img,\n    .fb-footer__badge--return img {\n      max-width: 90px;\n    }\n\n  }\n\n\n.fb-footer__newsletter {\n    width: calc(100% - 96px);\n    max-width: 1504px;\n    margin: 0 auto;\n    padding: 38px 0 34px;\n    border-bottom: 1px solid rgba(255,255,255,.14);\n    display: grid;\n    grid-template-columns: minmax(280px, .9fr) minmax(420px, 1.1fr);\n    align-items: center;\n    gap: 70px;\n  }\n\n  .fb-footer__newsletter [hidden] {\n    display: none !important;\n  }\n\n  .fb-footer__newsletter-kicker {\n    display: block;\n    margin-bottom: 7px;\n    color: #ff7a00;\n    font-size: 12px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: .1em;\n  }\n\n  .fb-footer__newsletter-copy h2 {\n    margin: 0;\n    color: #fff;\n    font-size: clamp(24px, 2vw, 32px);\n    line-height: 1.15;\n    font-weight: 800;\n  }\n\n  .fb-footer__newsletter-copy p {\n    margin: 9px 0 0;\n    color: #bac7d6;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .fb-footer__newsletter-fields {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 10px;\n  }\n\n  .fb-footer__newsletter-fields > input {\n    width: 100%;\n    min-width: 0