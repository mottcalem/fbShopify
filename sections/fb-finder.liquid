{% comment %}
  ---------------------------------------------------------------------------
  FootBalance — "Hedefin ne?" seçici
  ---------------------------------------------------------------------------
  Referansta hero'nun üstüne binen beyaz kart içinde iki seçenek duruyor.
  Dawn'ın Multicolumn'u ne negatif üst boşluk ne turuncu üst etiket veriyor.

  Kart ikonları: block > "İkon görseli" alanından yüklenir. Görsel yoksa
  yerine SVG basılır, bölüm yine düzgün görünür.

  Quiz 2. aşamada gelecek — şimdilik bağlantılar koleksiyonlara gidiyor.
  Müşteri 27.07 videosunda "bir yere gitmese de olur, yeri hazır olsun" dedi.
  ---------------------------------------------------------------------------
{% endcomment %}

{{ 'footbalance-custom.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .fb-finder {
    margin-top: -{{ section.settings.overlap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .fb-finder__grid {
    grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, minmax(0, 1fr));
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .fb-finder {
      margin-top: -{{ section.settings.overlap | times: 0.4 | round }}px;
    }
    #shopify-section-{{ section.id }} .fb-finder__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* =========================================
   FootBalance - Kişisel Ürün Önerisi Kartı
   ========================================= */

.fb-finder__grid {
  width: 100%;
}

.fb-finder__option--horizontal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;

  width: 100%;
  padding: 30px 32px;

  background: #0d3152;
  border: 1px solid #f87900;
  border-radius: 16px;

  text-decoration: none;
  box-sizing: border-box;

  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.fb-finder__option--horizontal:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(13, 49, 82, 0.15);
}

/* Sol metin alanı */
.fb-finder__option-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  flex: 1;
}

/* Başlık */
.fb-finder__option--horizontal .fb-finder__option-title {
  display: block;
  margin: 0;

  color: #ffffff;
  font-size: 20px;
  font-weight: 700;
  line-height: 1.3;
}

/* Açıklama */
.fb-finder__option--horizontal .fb-finder__option-text {
  display: block;
  margin: 0;

  color: rgba(255, 255, 255, 0.82);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.5;
}

/* Turuncu CTA */
.fb-finder__option-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  flex-shrink: 0;

  min-height: 48px;
  padding: 0 24px;

  background: #f87900;
  color: #ffffff;

  border-radius: 14px;

  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0.02em;

  transition: background 0.2s ease, transform 0.2s ease;
}

.fb-finder__option--horizontal:hover .fb-finder__option-button {
  background: #e86f00;
}

.fb-finder__option-button-arrow {
  font-size: 19px;
  line-height: 1;
  transition: transform 0.2s ease;
}

.fb-finder__option--horizontal:hover .fb-finder__option-button-arrow {
  transform: translateX(4px);
}


/* =========================
   MOBILE
   ========================= */

@media screen and (max-width: 749px) {

  .fb-finder__option--horizontal {
    flex-direction: column;
    align-items: stretch;
    gap: 20px;

    padding: 24px 20px;
  }

  .fb-finder__option--horizontal .fb-finder__option-title {
    font-size: 18px;
  }

  .fb-finder__option--horizontal .fb-finder__option-text {
    font-size: 14px;
  }

  .fb-finder__option-button {
    width: 100%;
    min-height: 48px;
  }
}

/* FB Finder - final override */

.fb-finder__grid .fb-finder__option.fb-finder__option--horizontal {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 32px !important;

  width: 100% !important;
  min-height: 125px !important;
  padding: 28px 32px !important;

  background: #0d3152 !important;
  border: 1px solid #0d3152 !important;
  border-radius: 16px !important;

  text-decoration: none !important;
}

.fb-finder__option--horizontal .fb-finder__option-content {
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  justify-content: center !important;
  text-align: left !important;
  gap: 6px !important;
  flex: 1 1 auto !important;
}

.fb-finder__option--horizontal .fb-finder__option-title {
  display: block !important;
  color: #ffffff !important;
  font-size: 20px !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
  text-align: left !important;
}

.fb-finder__option--horizontal .fb-finder__option-text {
  display: block !important;
  color: rgba(255, 255, 255, 0.82) !important;
  font-size: 14px !important;
  line-height: 1.5 !important;
  text-align: left !important;
}

.fb-finder__option--horizontal .fb-finder__option-button {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 12px !important;

  flex: 0 0 auto !important;

  min-height: 48px !important;
  padding: 0 24px !important;

  background: #f87900 !important;
  color: #ffffff !important;
  border-radius: 14px !important;

  font-size: 14px !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  text-decoration: none !important;
}

/* Mobil */
@media screen and (max-width: 749px) {
  .fb-finder__grid .fb-finder__option.fb-finder__option--horizontal {
    flex-direction: column !important;
    align-items: stretch !important;
    padding: 24px 20px !important;
  }

  .fb-finder__option--horizontal .fb-finder__option-button {
    width: 100% !important;
  }
}
</style>

<div class="fb-finder page-width">
  <div class="fb-finder__card">
    {%- if section.settings.overline != blank or section.settings.title != blank -%}
      <div class="fb-finder__head">
        {%- if section.settings.overline != blank -%}
          <span class="fb-overline">{{ section.settings.overline | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="fb-finder__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="fb-finder__grid">
  {%- for block in section.blocks -%}
    <a
      href="{{ block.settings.link | default: '#' }}"
      class="fb-finder__option fb-finder__option--horizontal"
      {{ block.shopify_attributes }}
    >
      <div class="fb-finder__option-content">
        {%- if block.settings.title != blank -%}
          <span class="fb-finder__option-title">
            {{ block.settings.title | escape }}
          </span>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <span class="fb-finder__option-text">
            {{ block.settings.text | escape }}
          </span>
        {%- endif -%}
      </div>

      {%- if block.settings.cta != blank -%}
        <span class="fb-finder__option-button">
          {{ block.settings.cta | escape }}
          <span class="fb-finder__option-button-arrow">→</span>
        </span>
      {%- endif -%}
    </a>
  {%- endfor -%}
</div>
  </div>
</div>

{% schema %}
{
  "name": "FB Hedefin ne?",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Turuncu üst etiket",
      "default": "Kişisel Ürün Önerisi"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Hedefin ne?"
    },
    {
      "type": "range",
      "id": "overlap",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Hero'ya binme miktarı",
      "info": "0 = hero'ya binmez, ayrı durur.",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Üst boşluk",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Alt boşluk",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Seçenek",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "İkon görseli",
          "info": "Boş bırakılırsa yerine sade bir ikon basılır."
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "İkon arka planı",
          "default": "#f4ede4"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Başlık"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Açıklama",
          "default": "Kısa açıklama"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Alt bağlantı metni",
          "default": "30 saniyede kişisel öneri"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Bağlantı"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "FB Hedefin ne?",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "title": "Destek bölgesi ve spora göre ürün bul",
            "text": "Önce destek bölgeni, sonra yaptığın sporu seç."
          }
        },
        {
          "type": "option",
          "settings": {
            "title": "Tabanlık seç",
            "text": "Konfor, destek ve performans için."
          }
        }
      ]
    }
  ]
}
{% endschema %}
