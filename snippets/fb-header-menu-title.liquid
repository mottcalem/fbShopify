{% comment %}
  Header navigation titles are managed in Shopify Navigation and are not
  automatically translated by locale JSON files. Keep Turkish as the source
  menu and provide the English storefront labels here until corresponding
  Navigation translations are added in Shopify Admin.

  Usage: {% render 'fb-header-menu-title', link: link %}
{% endcomment %}

{%- assign fb_menu_title = link.title -%}
{%- if localization.language.iso_code == 'en' -%}
  {%- case link.handle -%}
    {%- when 'tabanliklar' -%}
      {%- assign fb_menu_title = 'Insoles' -%}
    {%- when 'destek-coraplari' -%}
      {%- assign fb_menu_title = 'Support Socks' -%}
    {%- when 'vucut-destekleri', 'vucut-destek-urunleri' -%}
      {%- assign fb_menu_title = 'Body Supports' -%}
    {%- when 'tum-urunler' -%}
      {%- assign fb_menu_title = 'All Products' -%}
    {%- when 'dogru-urun-bul' -%}
      {%- assign fb_menu_title = 'Find the Right Product' -%}
    {%- when 'gunluk-konfor' -%}
      {%- assign fb_menu_title = 'Everyday Comfort' -%}
    {%- when 'medikal-seviye-destek' -%}
      {%- assign fb_menu_title = 'Medical-Grade Support' -%}
    {%- when 'guc-ve-performans' -%}
      {%- assign fb_menu_title = 'Power & Performance' -%}
    {%- when 'kompresyon-fs4' -%}
      {%- assign fb_menu_title = 'Compression (FS4+)' -%}
    {%- when 'plantar-fasiit-fs4' -%}
      {%- assign fb_menu_title = 'Plantar Fasciitis (FS4)' -%}
    {%- when 'bunyon-br4-hv3' -%}
      {%- assign fb_menu_title = 'Bunion (BR4-HV3)' -%}
    {%- when 'seyahat-ts5' -%}
      {%- assign fb_menu_title = 'Travel (TS5)' -%}
    {%- when 'diyabet-hassas-cilt-wp4' -%}
      {%- assign fb_menu_title = 'Diabetes & Sensitive Skin (WP4)' -%}
    {%- when 'performans-ta4' -%}
      {%- assign fb_menu_title = 'Performance (TA4)' -%}
    {%- when 'ayak-bilegi-af7' -%}
      {%- assign fb_menu_title = 'Ankle (AF7)' -%}
    {%- when 'diz-ks7' -%}
      {%- assign fb_menu_title = 'Knee (KS7)' -%}
    {%- when 'quadriceps-qs4' -%}
      {%- assign fb_menu_title = 'Quadriceps (QS4)' -%}
    {%- when 'el-bilegi-ws6' -%}
      {%- assign fb_menu_title = 'Wrist (WS6)' -%}
    {%- when 'dirsek-es3-es6' -%}
      {%- assign fb_menu_title = 'Elbow (ES3-ES6)' -%}
    {%- when 'kol-as6' -%}
      {%- assign fb_menu_title = 'Arm (AS6)' -%}
    {%- when 'kosu' -%}
      {%- assign fb_menu_title = 'Running' -%}
    {%- when 'futbol' -%}
      {%- assign fb_menu_title = 'Football' -%}
    {%- when 'basketbol' -%}
      {%- assign fb_menu_title = 'Basketball' -%}
    {%- when 'voleybol' -%}
      {%- assign fb_menu_title = 'Volleyball' -%}
    {%- when 'bisiklet' -%}
      {%- assign fb_menu_title = 'Cycling' -%}
    {%- when 'yuruyus', 'gunluk-yuruyus', 'gunluk-yuruyus-1' -%}
      {%- assign fb_menu_title = 'Walking' -%}
    {%- when 'plantar-fasiit' -%}
      {%- assign fb_menu_title = 'Plantar Fasciitis' -%}
    {%- when 'halluks-valgus' -%}
      {%- assign fb_menu_title = 'Hallux Valgus' -%}
    {%- when 'diyabet' -%}
      {%- assign fb_menu_title = 'Diabetes' -%}
    {%- when 'seyahat-odem' -%}
      {%- assign fb_menu_title = 'Travel & Swelling' -%}
    {%- when 'ayak-bakim' -%}
      {%- assign fb_menu_title = 'Foot Care' -%}
    {%- when 'ayak-bilegi-ve-kalf', 'ayak-bilegi-kalf' -%}
      {%- assign fb_menu_title = 'Ankle & Calf' -%}
  {%- endcase -%}
{%- endif -%}
{{- fb_menu_title | escape -}}
