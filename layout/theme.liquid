    ]
  },

  /* Destek Çorapları alt menüleri */
  'dc-kosu': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Koşu ve Toparlanma']
  },

  'dc-topuk': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Topuk ve Taban Ağrısı']
  },

  'dc-bunyon': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Bunyon']
  },

  'dc-seyahat': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Seyahat']
  },

  'dc-diyabet': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Diyabet & Hassas Cilt']
  },

  'dc-performans': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Günlük Performans']
  },

  /* Vücut Destekleri alt menüleri */
  'vd-ayak-bilegi': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Ayak Bileği']
  },

  'vd-diz': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Diz']
  },

  'vd-qdc': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['Quadriceps']
  },

  'vd-el-bilegi': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
    values: ['El Bileği']
  },

  'vd-dirsek': {
    filter: 'filter.p.m.custom.birlesik_kategori_filtresi',
